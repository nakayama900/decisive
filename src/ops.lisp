(in-package :gs2)

;;; big opcode dispatch
(defun op-dispatch (m tok c0)
  (declare (type fixnum c0))
  (cond
      ;; 0x20 negate/reverse/eval
      ((= c0 #x20)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (- x)))
               ((gs2-list-p x) (spush m (reverse x)))
               ((gs2-block-p x) (gs2-eval-tokens m x))
               (t (error 'gs2-error :message "negate / reverse")))))
      ((= c0 #x21)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (lognot x)))
               ((gs2-list-p x) (spush m (aref x 0)))
               (t (error 'gs2-error :message "bnot / head")))))
      ((= c0 #x22)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (if (zerop x) 1 0)))
               ((gs2-list-p x) (spush m (subseq x 1)))
               (t (error 'gs2-error :message "not / tail")))))
      ((= c0 #x23)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (abs x)))
               ((gs2-list-p x) (spush m (subseq x 0 (1- (length x)))))
               (t (error 'gs2-error :message "abs / init")))))
      ((= c0 #x24)
       (let ((x (spop m)))
         (cond ((gs2-num-p x)
                (spush m (map 'vector (lambda (c)
                                         (digit-char-p c))
                              (format nil "~d" (abs x)))))
               ((gs2-list-p x) (spush m (aref x (- (length x) 1))))
               (t (error 'gs2-error :message "digits / last")))))
      ((= c0 #x25)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (random x)))
               ((gs2-list-p x) (spush m (aref x (random (length x)))))
               (t (error 'gs2-error :message "random")))))
      ((= c0 #x26)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (- x 1)))
               ((gs2-list-p x)
                (spush m (subseq x 1)) (spush m (aref x 0)))
               (t (error 'gs2-error :message "dec / left-uncons")))))
      ((= c0 #x27)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (+ x 1)))
               ((gs2-list-p x)
                (spush m (subseq x 0 (1- (length x))))
                (spush m (aref x (- (length x) 1))))
               (t (error 'gs2-error :message "inc / right-uncons")))))
      ((= c0 #x28)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (signum x)))
               ((gs2-list-p x)
                (spush m (reduce (lambda (a b) (if (< (gs2-cmp a b) 0) a b))
                                 x)))
               (t (error 'gs2-error :message "sign / min")))))
      ((= c0 #x29)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (* x 1000)))
               ((gs2-list-p x)
                (spush m (reduce (lambda (a b) (if (> (gs2-cmp a b) 0) a b))
                                 x)))
               (t (error 'gs2-error :message "thousand / max")))))
      ((= c0 #x2a)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (* x 2)))
               ((gs2-list-p x)
                (let ((xx (if (and (> (length x) 0)
                                   (= (aref x (- (length x) 1)) 10))
                              (subseq x 0 (- (length x) 1))
                              (copy-seq x))))
                  (spush m (split xx (vector 10) nil))))
               (t (error 'gs2-error :message "double / lines")))))
      ((= c0 #x2b)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (truncate x 2)))
               ((gs2-list-p x)
                (spush m (join (map 'vector (lambda (i) (to-gs (show i))) x)
                               (vector 10))))
               (t (error 'gs2-error :message "half / unlines")))))
      ((= c0 #x2c)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (* x x)))
               ((gs2-list-p x)
                (spush m (map 'vector #'to-gs (py-str-split-space (to-ps x)))))
               (t (error 'gs2-error :message "square / words")))))
      ((= c0 #x2d)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (isqrt x)))
               ((gs2-list-p x)
                (spush m (join (map 'vector (lambda (i) (to-gs (show i))) x)
                               (vector 32))))
               (t (error 'gs2-error :message "sqrt / unwords")))))
      ((= c0 #x2e)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (vrange x)))
               ((gs2-list-p x) (spush m (length x)))
               (t (error 'gs2-error :message "range / length")))))
      ((= c0 #x2f)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (iota1 x)))
               ((gs2-list-p x) (spush m (py-sort x)))
               ((gs2-block-p x)
                (let ((l (spop m)))
                  (spush m (py-sort l :key (lambda (z)
                                             (spush m z)
                                             (gs2-eval-tokens m x)
                                             (spop m :junk nil))))))
               (t (error 'gs2-error :message "range1 / sort")))))
      ((= c0 #x30)                                   ; +
       (let* ((y (spop m)) (x (spop m)))
         (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (+ x y)))
               ((and (gs2-list-p x) (gs2-list-p y))
                (spush m (concatenate 'vector x y)))
               ((and (gs2-block-p x) (gs2-block-p y))
                (spush m (%make-gs2-block (concatenate 'vector (gs2-block-code x)
                                                  (gs2-block-code y)))))
               ((and (gs2-list-p x) (not (gs2-list-p y)))
                (spush m (concatenate 'vector x (vector y))))
               ((and (not (gs2-list-p x)) (gs2-list-p y))
                (spush m (concatenate 'vector (vector x) y)))
               (t (error 'gs2-error :message "add / catenate")))))
      ((= c0 #x31)                                   ; -
       (let* ((y (spop m)) (x (spop m)))
         (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (- x y)))
               ((and (gs2-list-p x) (gs2-list-p y)) (spush m (set-diff x y)))
               ((and (gs2-list-p x) (not (gs2-list-p y))) (spush m (set-diff x (vector y))))
               ((and (not (gs2-list-p x)) (gs2-list-p y)) (spush m (set-diff y (vector x))))
               (t (error 'gs2-error :message "sub / diff")))))
      ((= c0 #x32)                                   ; * mul/join/times/fold
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0) (swapped nil))
           (when (and (gs2-num-p x) (or (gs2-block-p y) (gs2-list-p y)))
             (rotatef x y) (setf swapped t))
           (when (and (gs2-block-p x) (gs2-list-p y))
             (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (* x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (join x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (let ((out (make-array 0 :adjustable t :fill-pointer 0)))
                    (loop repeat y do (loop for c across x
                                            do (vector-push-extend c out)))
                    (spush m out)))
                 ((and (gs2-block-p x) (gs2-num-p y))
                  (loop repeat y do (gs2-eval-tokens m x)))
                 ((and (gs2-list-p x) (gs2-block-p y))
                  (spush m (aref x 0))
                  (loop for i from 1 below (length x)
                        do (spush m (aref x i)) (gs2-eval-tokens m y)))
                 (t (error 'gs2-error :message "mul / join / times / fold"))))))
      ((= c0 #x33)                                   ; / div/chunks/split/each
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (not (gs2-list-p x)) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (truncate x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (spush m (chunks-of x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (split x y nil)))
                 ((and (gs2-list-p x) (gs2-block-p y))
                  (loop for i across x do (spush m i) (gs2-eval-tokens m y)))
                 (t (error 'gs2-error :message "div / chunks / split / each"))))))
      ((= c0 #x34)                                   ; % mod/step/clean-split/map
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (not (gs2-list-p x)) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (mod x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (spush m (step-slice x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (split x y t)))
                 ((and (gs2-list-p x) (gs2-block-p y)) (eval-map m y x))
                 (t (error 'gs2-error :message "mod / step / split / map"))))))
      ((= c0 #x35)                                   ; & and/get/when/filter
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-block-p x) (gs2-num-p y)) (rotatef x y))
           (when (and (gs2-num-p x) (gs2-list-p y)) (rotatef x y))
           (when (and (gs2-block-p x) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (logand x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (set-and x y)))
                 ((and (gs2-list-p x) (gs2-num-p y)) (spush m (aref x y)))
                 ((and (gs2-num-p x) (gs2-block-p y))
                  (when (not (zerop x)) (gs2-eval-tokens m y)))
                 ((and (gs2-list-p x) (gs2-block-p y)) (eval-filter m y x))
                 (t (error 'gs2-error :message "and / get / when / filter"))))))
      ((= c0 #x36)                                   ; | or/unless
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-block-p x) (gs2-num-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (logior x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (set-or x y)))
                 ((and (gs2-num-p x) (gs2-block-p y))
                  (when (zerop x) (gs2-eval-tokens m y)))
                 (t (error 'gs2-error :message "bor / unless"))))))
      ((= c0 #x37)                                   ; ^ xor/concatmap
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-block-p x) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (logxor x y)))
                 ((and (gs2-list-p x) (gs2-list-p y)) (spush m (set-xor x y)))
                 ((and (gs2-list-p x) (gs2-block-p y))
                  (let ((res (make-array 0 :adjustable t :fill-pointer 0)))
                    (loop for i across x
                          do (spush m i) (gs2-eval-tokens m y)
                             (loop for c across (spop m :junk nil)
                                   do (vector-push-extend c res)))
                    (spush m res)))
                 (t (error 'gs2-error :message "xor / concatmap"))))))
      ((= c0 #x38)                                   ; smallest/both
       (let ((y (spop m)))
         (if (gs2-block-p y)
             (let ((x (spop m)))
               (gs2-eval-tokens m y) (spush m x) (gs2-eval-tokens m y))
             (let ((x (spop m)))
               (spush m (if (< (gs2-cmp x y) 0) x y))))))
      ((= c0 #x39)                                   ; biggest
       (let ((y (spop m)) (x (spop m)))
         (spush m (if (> (gs2-cmp x y) 0) x y))))
      ((= c0 #x3a)                                   ; clamp
       (let ((z (spop m)) (y (spop m)) (x (spop m)))
         (spush m (min (max x y) z))))
      ((= c0 #x3c)                                   ; gcd/take
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-num-p x) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (py-gcd x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (spush m (subseq x 0 (min y (length x)))))
                 (t (error 'gs2-error :message "gcd / take"))))))
      ((= c0 #x3d)                                   ; lcm/drop
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-num-p x) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (py-lcm x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (spush m (subseq x (min y (length x)))))
                 (t (error 'gs2-error :message "lcm / drop"))))))
      ((= c0 #x3e)                                   ; pow/index
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (and (gs2-num-p x) (gs2-list-p y)) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y)) (spush m (expt x y)))
                 ((and (gs2-list-p x) (gs2-num-p y))
                  (let ((pos (position y x :test #'gs2-equal)))
                    (spush m (or pos -1))))
                 (t (error 'gs2-error :message "pow / index"))))))
      ((= c0 #x3f)                                   ; log/member
       (let* ((y0 (spop m)) (x0 (spop m)))
         (let ((y y0) (x x0))
           (when (gs2-list-p y) (rotatef x y))
           (cond ((and (gs2-num-p x) (gs2-num-p y))
                  (spush m (truncate (log x y))))
                 ((gs2-list-p x)
                  (spush m (if (position y x :test #'gs2-equal) 1 0)))
                 (t (error 'gs2-error :message "log / member"))))))
      ;; stack ops 0x40-0x4f
      ((= c0 #x40) (spush m (speek m)))
      ((= c0 #x41) (spush m (speek m)) (spush m (speek m)))
      ((= c0 #x42) (spush m (stack-pop-nth m -2)))
      ((= c0 #x43) (spush m (stack-pop-nth m -3)))
      ((= c0 #x44) (spush m (stack-pop-nth m -3)) (spush m (stack-pop-nth m -3)))
      ((= c0 #x45) (spush m (speek m -2)))
      ((= c0 #x46) (stack-delete-at m -2))
      ((= c0 #x47) (stack-insert m -2 (speek m)))
      ((= c0 #x48) (spush m (speek m -2)) (spush m (speek m -2)))
      ((= c0 #x49)
       (let ((n (spop m))) (spush m (speek m (- n)))))
      ((= c0 #x4a)
       (let ((n (spop m))) (spush m (stack-pop-nth m (- n)))))
      ((= c0 #x4b)                                   ; wrap-stack
       (let* ((copy (copy-seq (gs2-stack m)))
              (junk (gs2-junk m)))
         (setf (gs2-stack m) (make-array 1 :adjustable t :fill-pointer 1
                                         :initial-element copy)
               (gs2-junk m) junk)))
      ((= c0 #x4c)                                   ; leave-top
       (let ((top (speek m -1)) (junk (gs2-junk m)))
         (setf (gs2-stack m) (make-array 1 :adjustable t :fill-pointer 1
                                         :initial-element top)
               (gs2-junk m) junk)))
      ((= c0 #x4d) (spush m (vector (spop m))))
      ((= c0 #x4e) (let ((x (spop m))) (spush m (reverse (vrange x)))))
      ((= c0 #x4f)
       (let* ((y (spop m)) (x (spop m)))
         (unless (< x y) (rotatef x y))
         (spush m (vrange x y))))
      ((= c0 #x50) (spop m))
      ((= c0 #x51) (spop m) (spop m))
      ((= c0 #x52) (let ((x (spop m))) (spush m (to-gs (show x)))))
      ((= c0 #x53)
       (let ((x (spop m)))
         (spush m (map 'vector (lambda (i) (to-gs (show i))) x))))
      ((= c0 #x54)
       (let ((x (spop m)) (acc (make-string-output-stream)))
         (loop for i across x
               for first = t then nil
               do (unless first (write-char #\newline acc))
                  (write-string (show i) acc))
         (spush m (to-gs (get-output-stream-string acc)))))
      ((= c0 #x55)
       (let ((x (spop m)) (acc (make-string-output-stream)))
         (loop for i across x
               for first = t then nil
               do (unless first (write-char #\space acc))
                  (write-string (show i) acc))
         (spush m (to-gs (get-output-stream-string acc)))))
      ((or (= c0 #x56) (= c0 #x57))
       (let* ((x (to-ps (spop m)))
              (nums (map 'list #'parse-integer
                         (cl-ppcre:all-matches-as-strings "-?[0-9]+" x))))
         (spush m (if (= c0 #x56) (first nums)
                      (coerce nums 'vector)))))
      ((= c0 #x58)
       (let ((x (spop m))) (spush m (to-gs (concatenate 'string (show x)
                                                        '(#\newline))))))
      ((= c0 #x59)
       (let ((x (spop m))) (spush m (to-gs (concatenate 'string (show x)
                                                        '(#\space))))))
      ((= c0 #x5a)
       (let ((x (spop m)) (acc (make-string-output-stream)))
         (loop for i across x
               for first = t then nil
               do (unless first (write-string ", " acc))
                  (write-string (show i) acc))
         (spush m (to-gs (get-output-stream-string acc)))))
      ((= c0 #x5b)
       (let ((x (spop m)) (acc (make-string-output-stream)))
         (loop for i across x
               for first = t then nil
               do (unless first (write-string ", " acc))
                  (write-string (show i) acc))
         (spush m (to-gs (concatenate 'string "[" (get-output-stream-string acc)
                                      "]")))))
      ((<= #x5c c0 #x5e)                              ; ljust/center/rjust
       (let* ((fill (if (gs2-num-p (speek m -2)) (%p2c (spop m)) #\Space))
              (width (spop m))
              (s (spop m))
              (g (let ((str (show s)))
                   (cond ((= c0 #x5c) (py-ljust str width fill))
                         ((= c0 #x5d) (py-center str width fill))
                         (t (py-rjust str width fill))))))
         (spush m (to-gs g))))
      ((= c0 #x5f)
       (spush m (to-gs (py-repr (spop m)))))
      ((= c0 #x60)
       (let ((y (spop m)) (x (spop m)))
         (spush m (if (gs2-truthy x) y x))))          ; py x-and-y
      ((= c0 #x61)
       (let ((y (spop m)) (x (spop m)))
         (spush m (if (gs2-truthy x) x y))))          ; py x-or-y
      ((= c0 #x62)
       (let ((y (spop m)) (x (spop m)))
         (cond ((gs2-num-p x) (spush m (if (zerop (mod x y)) 0 1)))
               ((gs2-list-p x) (spush m (concatenate 'vector (vector y) x)))
               (t (error 'gs2-error :message "divides / left-cons")))))
      ((= c0 #x63)
       (let ((y (spop m)))
         (cond ((gs2-num-p y)
                (let ((x (spop m)))
                  (spush m (truncate x y))
                  (spush m (mod x y))))
               ((gs2-list-p y)
                (spush m (group-consecutive y)))
               (t (error 'gs2-error :message "divmod / group")))))
      ((= c0 #x64)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (if (zerop (mod x 2)) 1 0)))
               ((gs2-list-p x) (spush m (reduce #'+ x))))))
      ((= c0 #x65)
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (if (= (mod x 2) 1) 1 0)))
               ((gs2-list-p x) (spush m (reduce #'* x))))))
      ((= c0 #x66)
       (spush m (to-gs (with-output-to-string (out)
                         (loop for i from 1 to 100
                               for s = (concatenate 'string
                                            (if (zerop (mod i 3)) "Fizz" "")
                                            (if (zerop (mod i 5)) "Buzz" ""))
                               for v = (if (plusp (length s)) s (format nil "~d" i))
                               do (write-string v out)
                                  (when (< i 100) (write-char #\newline out)))))))
      ((= c0 #x67)                                   ; popcnt / right-cons
       (let ((x (spop m)))
         (cond ((gs2-num-p x)
                (loop with xx = (abs x) with p = 0
                      until (zerop xx)
                      do (incf p (logand xx 1)) (setf xx (ash xx -1))
                      finally (spush m p)))
               ((gs2-list-p x)
                (let ((y (spop m)))
                  (spush m (concatenate 'vector x (vector y))))))))
      ((= c0 #x68)                                   ; hello
       (let* ((x 0))
         (when (and (>= (slen m) 1) (gs2-num-p (speek m)))
           (let ((v (spop m)))
             (setf x (position v (concatenate 'vector (vrange 0 11)
                                              (vector 100 1000 16 64 256))))))
         (let* ((s1 (if (logbitp 0 x) "h" "H"))
                (s2 (if (logbitp 1 x) "W" "w"))
                (s3 (nth (logior (ash (logand x 4) -2) (ash (logand x 16) -3))
                         '("!" "" "." "...")))
                (s4 (if (logbitp 3 x) "" ","))
                (f (concatenate 'string s1 "ello" s4 " " s2 "orld" s3)))
           (spush m (to-gs f)))))
      ((or (= c0 #x69) (= c0 #x6a))                  ; base / binary
       (let ((b (if (= c0 #x6a) 2 (spop m))))
         (let ((x (spop m)))
           (cond ((gs2-num-p x)
                  (let ((xx (abs x)) (res nil))
                    (loop until (zerop xx)
                          do (push (mod xx b) res) (setf xx (truncate xx b)))
                    (spush m (if res (coerce res 'vector)
                                 (make-array 0)))))
                 ((gs2-list-p x)
                  (let ((res 0))
                    (loop for i across x do (setf res (+ (* res b) i)))
                    (spush m res)))
                 (t (error 'gs2-error :message "base / binary"))))))
      ((= c0 #x6b)                                   ; is-prime / filter primes
       (let ((x (spop m)))
         (cond ((gs2-num-p x) (spush m (if (is-prime* x) 1 0)))
               ((gs2-list-p x)
                (spush m (coerce (loop for i across x
                                       when (and (gs2-num-p i) (is-prime* i))
                                         collect i)
                                 'vector)))
               (t (error 'gs2-error :message "is-prime")))))
      ((= c0 #x6c)                                   ; primes ops
       (let ((op (spop m)) (x (spop m)))
         (case op
           (0 (spush m (n-primes x)))
           (1 (spush m (primes-below x)))
           (2 (spush m (next-prime x)))
           (3 (spush m (totient x)))
           (4 (spush m (factor-num x nil)))
           (5 (spush m (factor-num x t))))))
      ((= c0 #x6d)                                   ; scan
       (let ((f (spop m)))
         (flet ((call-f (x y)
                  (spush m x) (spush m y) (gs2-eval-tokens m f)
                  (spop m)))
           (let* ((xs (map 'list #'identity (spop m)))
                  (res (list (pop xs))))
             (loop while xs
                   do (push (call-f (first res) (pop xs)) res))
             (spush m (coerce (nreverse res) 'vector))))))
      ((<= #x70 c0 #x75)                             ; comparisons
       (let ((y (spop m)) (x (spop m)))
         (let ((r (case c0
                    (#x70 (< (gs2-cmp x y) 0))
                    ;; python2 `==` returns True for equal values even
                    ;; across types; only *ordering* (< > <= >=) is a py2
                    ;; type-name sort. So #x71 uses structural equality.
                    (#x71 (if (gs2-equal x y) 1 0))
                    (#x72 (> (gs2-cmp x y) 0))
                    (#x73 (>= (gs2-cmp x y) 0))
                    (#x74 (/= (gs2-cmp x y) 0))
                    (#x75 (<= (gs2-cmp x y) 0)))))
           (spush m (if r 1 0)))))
      ((= c0 #x76)
       (let ((y (spop m)) (x (spop m)))
         (spush m (gs2-cmp x y))))
      ((= c0 #x77)                                   ; is-sorted
       (let ((x (spop m)))
         (cond ((gs2-list-p x)
                (spush m (if (gs2-equal x (py-sort x)) 1 0)))
               ((gs2-block-p x)
                (let ((l (spop m)))
                  (let ((sorted-l (py-sort l :key (lambda (z)
                                                    (spush m z)
                                                    (gs2-eval-tokens m x)
                                                    (spop m)))))
                    (spush m (if (gs2-equal l sorted-l) 1 0)))))

               (t (error 'gs2-error :message "sorted")))))
      ((= c0 #x78)                                   ; shift-left / inits
       (let ((y (spop m)))
         (if (gs2-list-p y)
             (spush m (coerce (loop for i to (length y)
                                     collect (subseq y 0 i))
                              'vector))
             (let ((x (spop m)))
               (spush m (ash x y))))))
      ((= c0 #x79)                                   ; shift-right / tails
       (let ((y (spop m)))
         (if (gs2-list-p y)
             (spush m (coerce (loop for i to (length y)
                                     collect (subseq y (- (length y) i)))
                              'vector))
             (let ((x (spop m)))
               (spush m (ash x (- y)))))))
      ((= c0 #x7a)                                   ; digit-left / enumerate
       (let ((y (spop m)))
         (if (gs2-list-p y)
             (spush m (map 'vector (lambda (i x) (vector i x))
                           (vrange (length y)) y))
             (let ((x (spop m)))
               (spush m (* x (expt 10 y)))))))
      ((= c0 #x7b)
       (let ((y (spop m)) (x (spop m)))
         (spush m (truncate x (expt 10 y)))))
      ((= c0 #x7c) (spush m (expt 2 (spop m))))
      ((= c0 #x7d) (spush m (expt 10 (spop m))))
      ((= c0 #x7e) (spush m (- (expt 2 (spop m)) 1)))
      ((= c0 #x7f) (spush m (- (expt 10 (spop m)) 1)))
      ((= c0 #x80) (let ((y (spop m)) (x (spop m))) (spush m (vector x y))))
      ((= c0 #x81)
       (let ((n (spop m)) (x (spop m)))
         (spush m (make-array (max 0 n) :initial-element x))))
      ((= c0 #x82)                                   ; take-end
       (let ((y (spop m)) (x (spop m)))
         (when (and (gs2-num-p x) (gs2-list-p y)) (rotatef x y))
         (spush m (if (>= y 0)
                      (subseq x (max 0 (- (length x) y)))
                      (subseq x (+ (length x) y))))))
      ((= c0 #x83)                                   ; cartesian product
       (let ((y (spop m)) (x (spop m)))
         (spush m (coerce (loop for a across x
                                append (loop for b across y
                                             collect (vector a b)))
                          'vector))))
      ((= c0 #x84) (spush m (vrange 65 91)))
      ((= c0 #x85) (spush m (vrange 97 123)))
      ((= c0 #x86) (spush m (vrange 48 58)))
      ((= c0 #x87) (spush m (vrange 32 127)))
      ((<= #x88 c0 #x8f)                             ; char classes
       (let* ((x0 (to-ps (spop m)))
              (x (if (characterp x0) (string x0) x0))
              (r (case c0
                   (#x88 (py-alnum-p x))
                   (#x89 (py-alpha-p x))
                   (#x8a (py-digit-p x))
                   (#x8b (py-lower-p x))
                   (#x8c (py-space-p x))
                   (#x8d (py-upper-p x))
                   (#x8e (py-printable-p x))
                   (#x8f (py-hexdigit-p x)))))
         (spush m (if r 1 0))))
      ((= c0 #x90)                                   ; nub
       (let ((xs (spop m))
             (uniq (make-array 0 :adjustable t :fill-pointer 0)))
         (loop for x across xs
               unless (loop for u across uniq thereis (gs2-equal x u))
                 do (vector-push-extend x uniq))
         (spush m uniq)))
      ((= c0 #x91)                                   ; compress
       (let ((ns (spop m)) (xs (spop m))
             (new (make-array 0 :adjustable t :fill-pointer 0)))
         (loop for n across ns
               for x across xs
               do (loop repeat n do (vector-push-extend x new)))
         (spush m new)))
      ((= c0 #x92)                                   ; select
       (let ((xs (spop m)) (iis (spop m))
             (new (make-push-array)))
         (loop for i across iis do (vector-push-extend (aref xs i) new))
         (spush m new)))
      ((= c0 #x93)                                   ; permutations
       (let ((xs (spop m)))
         (when (gs2-num-p xs)
           (let ((n xs)) (setf xs (spop m))))
         (spush m (coerce (permutations-of xs) 'vector))))
      ((= c0 #x94)                                   ; fold-product
       (let ((xss (spop m)))
         ;; python: Block is a namedtuple (tuple of its fields) — iterating a
         ;; Block yields (code,) so each Block inside behaves as 1-elem seq.
         (when (gs2-block-p xss) (setf xss (gs2-block-code xss)))
         ;; python: iterating a Block yields (code,) — 1 field → wrap in 1-elem
         ;; seq. A token string inside a block is *one* product element (python
         ;; iterates lists element-wise, and the token is a single str), so a
         ;; bare string must also be wrapped (CL across would split chars).
         (setf xss (map 'vector (lambda (x)
                                  (cond ((gs2-block-p x)
                                         (vector (gs2-block-code x)))
                                        ((stringp x)
                                         (vector x))
                                        (t x)))
                        xss))
         (spush m (coerce (cartesian-fold xss) 'vector))))
      ((= c0 #x95)                                   ; repeat-product
       (let ((n (spop m)) (xs (spop m)))
         (spush m (coerce (cartesian-repeat xs n) 'vector))))
      ((= c0 #x96)                                   ; combinations
       (let ((n (spop m)) (xs (spop m)))
         (spush m (coerce (combinations-of xs n) 'vector))))
      ((= c0 #x97)                                   ; combinations w/ repl
       (let ((n (spop m)) (xs (spop m)))
         (spush m (coerce (combinations-with-replacement-of xs n)
                          'vector))))
      ((= c0 #x98)                                   ; pairwise
       (let ((xs (spop m)))
         (spush m (coerce (loop for i below (1- (length xs))
                                 collect (vector (aref xs i)
                                                 (aref xs (1+ i))))
                          'vector))))
      ((= c0 #x99)                                   ; flatten
       (spush m (flatten-gs (spop m))))
      ((= c0 #x9a)                                   ; transpose
       (let ((xs (spop m)))
         (spush m (transpose-of xs))))
      ((<= #xa0 c0 #xaf)                             ; junk refs: python junk[-1-k]
       (let* ((k (logand c0 15))
              (idx (- -1 k)))          ; -1-k as python index
         (declare (ignore idx))
         (if (< k (length (gs2-junk m)))
             (spush m (nth k (gs2-junk m)))   ; junk list head = most recent pop
             (error 'gs2-error :message "junk index out of range"))))
      ((= c0 #xb0)                                   ; zip
       (let ((ys (spop m)) (xs (spop m)))
         (spush m (coerce (loop for x across xs
                                for y across ys
                                collect (vector x y))
                          'vector))))
      ((= c0 #xb1)                                   ; zipwith
       (let ((f (spop m)) (ys (spop m)) (xs (spop m))
             (l0 (slen m)))
         (loop for x across xs
               for y across ys
               do (spush m x) (spush m y) (gs2-eval-tokens m f))
         (setf (stack-last-n m (- (slen m) l0))
               (stack-slice m l0))))
      ((= c0 #xb2)                                   ; counter
       (spush m (gs2-counter m))
       (incf (gs2-counter m)))
      ((<= #xc8 c0 #xcb)                             ; save
       (setf (aref (gs2-regs m) (logand c0 3)) (speek m)))
      ((<= #xcc c0 #xcf)                             ; put
       (setf (aref (gs2-regs m) (logand c0 3)) (spop m)))
      ((<= #xd0 c0 #xd3)                             ; get
       (spush m (aref (gs2-regs m) (logand c0 3))))
      ((<= #xd4 c0 #xd7)                             ; nip
       (let* ((st (gs2-stack m))
              (idx (- (slen m) 2)))
         (setf (aref (gs2-regs m) (logand c0 3)) (aref st idx))
         (stack-delete-at m -2)))
      ((<= #xd8 c0 #xdb)                             ; tuck
       (stack-insert m -1 (aref (gs2-regs m) (logand c0 3))))
      ((<= #xdc c0 #xdf)                             ; show reg
       (spush m (to-gs (show (aref (gs2-regs m) (logand c0 3))))))
      (t (error 'gs2-error :message (format nil "invalid token ~s" tok)))))



;;; ---------------------------------------------------------------- comprobridge ops
;;; #xC7 <id>: call a comprolib function by alias id (see comprobridge.lisp)

(defun cpl-gs2->cl (x)
  "gs2 value -> CL value for comprolib calls."
  (cond ((gs2-num-p x) x)
        ((gs2-list-p x)
         (if (every (lambda (v) (typep v 'integer)) x)
             (coerce x 'vector)
             (coerce (map 'list #'cpl-gs2->cl x) 'vector)))
        ((stringp x) x)
        (t (error 'gs2-error :message "cpl: cannot convert value"))))

(defun cpl-cl->gs2 (v)
  "CL value -> gs2 value."
  (typecase v
    (integer v)
    (boolean (if v 1 0))
    (string (coerce v 'vector))
    (list (if (and (consp (first v)) (integerp (car (first v))))
              (coerce (loop for (p . e) in v append (list p e)) 'vector)
              (coerce (map 'list #'cpl-cl->gs2 v) 'vector)))
    (vector (coerce (map 'list #'cpl-cl->gs2 v) 'vector))
    (cons (cpl-cl->gs2 (car v)))
    (t (error 'gs2-error :message "cpl: cannot convert result"))))

(defun cpl-block-fn (f)
  "gs2 block value -> single-argument CL function (for argmax/argmin)."
  (lambda (x)
    (let ((m (make-gs2 "" "")))
      (spush m x)
      (gs2-eval-tokens m (gs2-block-code f))
      (aref (gs2-stack m) 0))))

(defun cpr-values->list (&rest vals)
  "pack numeric values into a gs2 list (nils dropped)."
  (coerce (map 'list #'cpl-cl->gs2 (remove-if-not #'numberp vals)) 'vector))

(defun cpl-call (m id)
  "dispatch op #xC7: call comprolib alias ID with args popped from the stack."
  (ensure-cpl-alias-vector)
  (let ((entry (and (>= id 0) (< id (length *cpl-alias-vector*))
                    (aref *cpl-alias-vector* id))))
    (unless entry
      (error 'gs2-error :message (format nil "cpl: unknown id ~a" id)))
    ;; entries are stored as vectors (see ensure-cpl-alias-vector)
    (let* ((name (aref entry 0))
           (nargs (aref entry 1))
           (shape (aref entry 2))
           (fn (aref entry 3)))
      (declare (ignore name))
      (let ((args (make-list nargs)))
        (loop for i from (1- nargs) downto 0
              do (setf (nth i args) (cpl-gs2->cl (spop m))))
        (let ((result (apply fn args)))
          (spush m
                 (case shape
                   (:handle (let ((h *cpl-next-handle*))
                              (incf *cpl-next-handle*)
                              (setf (gethash h *cpl-objects*) result)
                              h))
                   (:values (multiple-value-bind (a b c) result
                              (cpr-values->list a b c)))
                   (:first-of-values (multiple-value-bind (a b c) result
                                       (declare (ignore b c))
                                       (cpl-cl->gs2 a)))
                   (:values-or-nil (multiple-value-bind (a b) result
                                     (if a (coerce (list a b) 'vector) (vector))))
                   ;; :int, :bool, :int-list, :alist, :raw, ... -> plain convert
                   (otherwise (cpl-cl->gs2 result)))))))))

(defvar *cpl-alias-vector* nil)
(defvar *cpl-alias-vector-built* nil)

(defun ensure-cpl-alias-vector ()
  ;; built lazily: ops.lisp loads before comprobridge.lisp defines
  ;; *cpl-aliases*, so the vector cannot be constructed at load time.
  (unless *cpl-alias-vector-built*
    (setf *cpl-alias-vector*
          (coerce (mapcar (lambda (e) (coerce e 'vector)) *cpl-aliases*) 'vector)
          *cpl-alias-vector-built* t)))

(defun cpl-call-op (m id-byte)
  "op #xC7: ID-BYTE is the byte immediately after #xC7 in the program."
  (ensure-cpl-alias-vector)
  (cpl-call m (char-code id-byte)))
