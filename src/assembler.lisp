(in-package :gs2)

;;; ---------------------------------------------------------------- assembler

(defparameter *mnemonics*
  '())

(defun build-mnemonics ()
  (let ((table (make-hash-table :test 'equal))
        (defs
          ;; (byte . mnemonics) — mirrors how gs2c.py parses the #= comments in gs2.py
          '((#x0a "new-line")
            (#x0b "empty-list")
            (#x0c "empty-block")
            (#x0d "space")
            (#x0e "make-array" "extract-array" "dump")
            (#x0f "exit")
            (#x20 "negate" "reverse" "eval")
            (#x21 "bnot" "head")
            (#x22 "not" "tail")
            (#x23 "abs" "init")
            (#x24 "digits" "last")
            (#x25 "random")
            (#x26 "dec" "left-uncons")
            (#x27 "inc" "right-uncons")
            (#x28 "sign" "min")
            (#x29 "thousand" "max")
            (#x2a "double" "lines")
            (#x2b "half" "unlines")
            (#x2c "square" "words")
            (#x2d "sqrt" "unwords")
            (#x2e "range" "length")
            (#x2f "range1" "sort")
            (#x30 "add" "cat" "+")
            (#x31 "sub" "diff" "-")
            (#x32 "mul" "join" "times" "fold" "*")
            (#x33 "div" "chunks" "split" "each" "/")
            (#x34 "mod" "step" "clean-split" "map" "%")
            (#x35 "and" "get" "when" "filter" "&")
            (#x36 "or" "unless" "|")
            (#x37 "xor" "concatmap" "^")
            (#x38 "smallest" "both")
            (#x39 "biggest")
            (#x3a "clamp")
            (#x3c "gcd" "take")
            (#x3d "lcm" "drop")
            (#x3e "pow" "index")
            (#x3f "log" "member")
            (#x40 "dup")
            (#x41 "dup2")
            (#x42 "swap")
            (#x43 "rot")
            (#x44 "rrot")
            (#x45 "over")
            (#x46 "nip")
            (#x47 "tuck")
            (#x48 "2dup")
            (#x49 "pick")
            (#x4a "roll")
            (#x4b "wrap-stack")
            (#x4c "leave-top")
            (#x4d "itemize")
            (#x4e "rrange")
            (#x4f "crange")
            (#x50 "pop")
            (#x51 "pop2")
            (#x52 "show")
            (#x53 "map-show")
            (#x54 "show-lines")
            (#x55 "show-words")
            (#x56 "read-num")
            (#x57 "read-nums")
            (#x58 "show-line")
            (#x59 "show-space")
            (#x5a "show-comma")
            (#x5b "show-python")
            (#x5c "ljust")
            (#x5d "center")
            (#x5e "rjust")
            (#x5f "inspect")
            (#x60 "logical-and")
            (#x61 "logical-or")
            (#x62 "divides" "left-cons")
            (#x63 "divmod" "group")
            (#x64 "sum" "even")
            (#x65 "product" "odd")
            (#x66 "fizzbuzz")
            (#x67 "popcnt" "right-cons")
            (#x68 "hello")
            (#x69 "base")
            (#x6a "binary")
            (#x6b "is-prime")
            (#x6c "primes")
            (#x6d "scan")
            (#x70 "lt" "<")
            (#x71 "eq" "=")
            (#x72 "gt" ">")
            (#x73 "ge" ">=")
            (#x74 "ne" "!=")
            (#x75 "le" "<=")
            (#x76 "cmp")
            (#x77 "is-sorted")
            (#x78 "shift-left" "inits")
            (#x79 "shift-right" "tails")
            (#x7a "digit-left" "enumerate")
            (#x7b "digit-right")
            (#x7c "power-of-2")
            (#x7d "power-of-10")
            (#x7e "sub-power-of-2")
            (#x7f "sub-power-of-10")
            (#x80 "pair")
            (#x81 "copies")
            (#x82 "take-end")
            (#x83 "cartesian-product")
            (#x84 "uppercase-alphabet")
            (#x85 "lowercase-alphabet")
            (#x86 "ascii-digits")
            (#x87 "printable-ascii")
            (#x88 "is-alnum")
            (#x89 "is-alpha")
            (#x8a "is-digit")
            (#x8b "is-lower")
            (#x8c "is-space")
            (#x8d "is-upper")
            (#x8e "is-printable")
            (#x8f "is-hexdigit")
            (#x90 "uniq" "nub")
            (#x91 "compress")
            (#x92 "select")
            (#x93 "permutations")
            (#x94 "fold-product")
            (#x95 "repeat-product")
            (#x96 "combinations")
            (#x97 "combinations-with-replacement")
            (#x98 "pairwise")
            (#x99 "flatten")
            (#x9a "transpose")
            (#xb0 "zip")
            (#xb1 "zipwith")
            (#xb2 "counter")
            (#xc8 "save-a")
            (#xc9 "save-b")
            (#xca "save-c")
            (#xcb "save-d")
            (#xcc "pop-a")
            (#xcd "pop-b")
            (#xce "pop-c")
            (#xcf "pop-d")
            (#xd0 "push-a")
            (#xd1 "push-b")
            (#xd2 "push-c")
            (#xd3 "push-d")
            (#xd4 "nip-a")
            (#xd5 "nip-b")
            (#xd6 "nip-c")
            (#xd7 "nip-d")
            (#xd8 "tuck-a")
            (#xd9 "tuck-b")
            (#xda "tuck-c")
            (#xdb "tuck-d")
            (#xdc "show-a")
            (#xdd "show-b")
            (#xde "show-c")
            (#xdf "show-d"))))
    (loop for (byte . names) in defs
          do (dolist (nm names) (setf (gethash nm table) byte)))
    ;; generated families
    (loop for i below 16
          do (setf (gethash (format nil "@~d" i) table) (logior #xa0 i))
             (setf (gethash (format nil "junk~d" i) table) (logior #xa0 i)))
    (loop for i below 8
          for c across "abcd"
          for k = 0 then (1+ k)
          do (setf (gethash (format nil "save-~c" c) table) (logior #xc8 k))
             (setf (gethash (format nil "pop-~c" c) table) (logior #xcc k))
             (setf (gethash (format nil "push-~c" c) table) (logior #xd0 k))
             (setf (gethash (format nil "nip-~c" c) table) (logior #xd4 k))
             (setf (gethash (format nil "tuck-~c" c) table) (logior #xd8 k))
             (setf (gethash (format nil "show-~c" c) table) (logior #xdc k)))
    (loop for i below 8
          do (setf (gethash (format nil "b~d" (1+ i)) table) (logior #xe0 i))
             (setf (gethash (format nil "block~d" (1+ i)) table) (logior #xe0 i))
             (setf (gethash (format nil "m~d" (1+ i)) table) (logior #xe8 i))
             (setf (gethash (format nil "map~d" (1+ i)) table) (logior #xe8 i))
             (setf (gethash (format nil "f~d" (1+ i)) table) (logior #xf0 i))
             (setf (gethash (format nil "filter~d" (1+ i)) table) (logior #xf0 i))
             (when (< (logior #xf8 i) #xfd)
               (setf (gethash (format nil "t~d" (1+ i)) table) (logior #xf8 i))
               (setf (gethash (format nil "both~d" (1+ i)) table)
                     (logior #xf8 i))))
    table))

(defvar *mnemonic-table* (build-mnemonics))

(eval-when (:load-toplevel :execute)
  ;; extra mnemonics from gs2c.py not derivable from '#=' comments
  (setf (gethash "'" *mnemonic-table*) #xe0)
  (setf (gethash "{" *mnemonic-table*) #x08)
  (setf (gethash "}" *mnemonic-table*) #x09)
  (setf (gethash "m:" *mnemonic-table*) #xfe)
  (setf (gethash "f:" *mnemonic-table*) #xff))

(defun compile-num (i)
  (cond ((<= 0 i 10) (vector (code-char (+ i #x10))))
        ((= i 100) (vector (code-char #x1b)))
        ((= i 1000) (vector (code-char #x1c)))
        ((= i 16) (vector (code-char #x1d)))
        ((= i 64) (vector (code-char #x1e)))
        ((= i 256) (vector (code-char #x1f)))
        ((<= 0 i #xff) (vector (code-char #x01) (code-char i)))
        ((<= -32768 i 32767)
         (let ((u (logand i #xffff)))
           (vector (code-char #x02) (code-char (logand u #xff))
                   (code-char (logand (ash u -8) #xff)))))
        ((<= -2147483648 i 2147483647)
         (let ((u (logand i #xffffffff)))
           (vector (code-char #x03)
                   (code-char (logand u #xff))
                   (code-char (logand (ash u -8) #xff))
                   (code-char (logand (ash u -16) #xff))
                   (code-char (logand (ash u -24) #xff)))))
        (t (error 'gs2-error
                  :message (format nil "couldn't compile number: ~a" i)))))

(defun assemble (s)
  "Assemble gs2c syntax into a string of gs2 bytes (latin-1 string)."
  (let* ((lines (remove-if (lambda (l) (or (zerop (length l))
                                           (char= (char l 0) #\#)))
                           (split-by-char s #\newline)))
         (joined (apply #'concatenate 'string
                        (mapcar (lambda (l) (concatenate 'string l " "))
                                lines)))
         (tokens (tokenize-asm joined))
         (string-mode nil)
         (string-type nil)
         (strings nil)
         (out (make-push-array)))
    (flet ((emit (v) (loop for c across v do (vector-push-extend c out))))
      (loop for tok across tokens
            do (cond
                 ((or (digit-char-p (char tok 0))
                      (and (> (length tok) 1)
                           (char= (char tok 0) #\-)
                           (digit-char-p (char tok 1))))
                  (emit (compile-num (parse-integer tok))))
                 ((and (char= (char tok 0) #\') (> (length tok) 1))
                  (emit (compile-num (char-code (char tok 1)))))
                 ((member tok '("(" "w(" "p(" "m(" "s(" "f(" "v(")
                          :test #'string=)
                  (setf string-mode t)
                  (setf string-type
                        (cdr (assoc tok '(("(" . regular) ("w(" . array)
                                          ("p(" . printf) ("m(" . regex-match)
                                          ("s(" . regex-sub) ("f(" . regex-find)
                                          ("v(" . regex-split))
                                      :test #'string=)))
                  (setf strings nil))
                 ((string= tok ")")
                  (setf string-mode nil)
                  (let* ((s-close (cdr (assoc string-type
                                              '((regular . #x05)
                                                (array . #x06)
                                                (printf . #x9b)
                                                (regex-match . #x9c)
                                                (regex-sub . #x9d)
                                                (regex-find . #x9e)
                                                (regex-split . #x9f))))))
                    (if (and (= (length strings) 1)
                             (= (length (first strings)) 1))
                        (emit (concatenate 'string
                                           (string (code-char #x07))
                                           (first strings)))
                        (emit (concatenate 'string
                                           (string (code-char #x04))
                                           (join-strings-with
                                            strings (string (code-char #x07)))
                                           (string (code-char s-close)))))))
                 ((or string-mode (char= (char tok 0) #\"))
                  (cond ((char= (char tok 0) #\")
                         (let ((inner (unescape-python-string tok)))
                           (if string-mode
                               (push inner strings)
                               (if (= (length inner) 1)
                                   (emit (concatenate 'string
                                                      (string (code-char #x07))
                                                      inner))
                                   (emit (concatenate 'string
                                                      (string (code-char #x04))
                                                      inner
                                                      (string (code-char #x05))))))))
                        (t (push tok strings))))
                 (t (let ((cpl (cpl-lookup (string-downcase tok))))
                      (if cpl
                          ;; comprolib alias: emit #xC7 followed by the id byte
                          (emit (concatenate 'string
                                             (string (code-char #xc7))
                                             (string (code-char
                                                      (gethash (string-downcase tok)
                                                               *cpl-id-table*)))))
                          (let ((byte (or (gethash (string-downcase tok)
                                                   *mnemonic-table*)
                                          (error 'gs2-error
                                                 :message
                                                 (format nil "unknown symbol: ~a"
                                                         tok)))))
                            (emit (string (code-char byte)))))))))
      (let ((str (coerce out 'string)))
        (if (and (> (length str) 0) (char= (char str 0) (code-char #x04)))
            (subseq str 1)
            str)))))
(defun split-by-char (s c)
  (let ((parts nil) (cur (make-string-output-stream)))
    (loop for x across s
          if (char= x c) do (push (get-output-stream-string cur) parts)
          else do (write-char x cur))
    (push (get-output-stream-string cur) parts)
    (nreverse parts)))

(defun tokenize-asm (s)
  ;; python: re.findall of quoted strings or non-space runs
  (let ((tokens nil) (i 0) (n (length s)))
    (loop while (< i n)
          do (let ((c (char s i)))
               (cond ((char= c #\")
                      (let ((j (position #\" s :start (1+ i))))
                        (if j
                            (progn (push (subseq s i (1+ j)) tokens)
                                   (setf i (1+ j)))
                            (progn (push (subseq s i) tokens) (setf i n)))))
                     ((char= c #\space) (incf i))
                     (t (let ((j (position #\space s :start i)))
                          (if j
                              (progn (push (subseq s i j) tokens) (setf i j))
                              (progn (push (subseq s i) tokens) (setf i n))))))))
    (coerce (nreverse tokens) 'vector)))

(defun join-strings-with (strings sep)
  (with-output-to-string (out)
    (loop for s in (reverse strings)
          for first = t then nil
          do (unless first (write-string sep out))
             (write-string s out))))

(defun unescape-python-string (tok)
  ;; python eval() of a "..." literal: handle common escapes
  (let ((body (subseq tok 1 (1- (length tok))))
        (out (make-string-output-stream)))
    (loop for i below (length body)
          for c = (char body i)
          do (cond
               ((and (char= c #\\) (< (1+ i) (length body)))
                (let ((d (char body (1+ i))))
                  (case d
                    (#\n (write-char #\newline out) (incf i))
                    (#\t (write-char #\tab out) (incf i))
                    (#\\ (write-char #\\ out) (incf i))
                    (#\" (write-char #\" out) (incf i))
                    (#\' (write-char #\' out) (incf i))
                    (t (write-char c out)))))
               (t (write-char c out))))
    (get-output-stream-string out)))

